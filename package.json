{
  "name": "mynk",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "Bookmark manager that summarizes, categorizes and tags your saved pages with a local or cloud AI model.",
  "author": "SKBv0",
  "homepage": "https://github.com/SKBv0/mynk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKBv0/mynk.git"
  },
  "bugs": {
    "url": "https://github.com/SKBv0/mynk/issues"
  },
  "keywords": [
    "bookmarks",
    "bookmark-manager",
    "tauri",
    "react",
    "rust",
    "local-first",
    "ollama",
    "openrouter",
    "mcp",
    "desktop"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "prepare:rust": "node scripts/prepare-rust.mjs",
    "build:mcp": "node scripts/copy-mcp-sidecar.mjs --ensure && node scripts/build-env.mjs --check=src-tauri/target/release/mynk-mcp cargo build --release --manifest-path src-tauri/Cargo.toml --bin mynk-mcp && node scripts/copy-mcp-sidecar.mjs",
    "licenses": "node scripts/third-party.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src scripts public .github src-tauri/capabilities \"*.{js,cjs,mjs,ts,json,html,yml}\" \"src-tauri/*.json\"",
    "format:check": "prettier --check src scripts public .github src-tauri/capabilities \"*.{js,cjs,mjs,ts,json,html,yml}\" \"src-tauri/*.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:lint": "npm run prepare:rust && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "npm run prepare:rust && cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "tauri:dev": "npm run prepare:rust && tauri dev",
    "tauri:e2e": "npm run prepare:rust && tauri dev --config src-tauri/tauri.e2e.json",
    "tauri:build": "node scripts/build-env.mjs --check=src-tauri/target/release/mynk,src-tauri/target/release/mynk-mcp,src-tauri/target/release/bundle,src-tauri/binaries,dist tauri build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "^2.9.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "classnames": "^2.5.1",
    "d3-force": "^3.0.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "~2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
