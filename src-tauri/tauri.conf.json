{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MYNK",
  "version": "0.1.0",
  "identifier": "com.mynk.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:7426",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run build:mcp"
  },
  "app": {
    "windows": [
      {
        "title": "MYNK",
        "label": "main",
        "width": 1600,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#0b0b0d"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:7426 http://localhost:7426",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:7426 http://localhost:7426",
        "style-src": "'self' 'unsafe-inline' http://127.0.0.1:7426 http://localhost:7426",
        "font-src": "'self' data: http://127.0.0.1:7426 http://localhost:7426",
        "img-src": "'self' data: blob: asset: http://asset.localhost http://127.0.0.1:7426 http://localhost:7426",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:7426 ws://127.0.0.1:7426 http://localhost:7426 ws://localhost:7426",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**/com.mynk.desktop/snapshots/*"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwRjg0NjA0NkVDNzBGNDYKUldSR0Q4ZHVCRWI0c09OdExXWlB4SFBUcXoyUGxINXA0blRPQ05UU3ZFR1VLMWpBNW0yTXR0WUwK",
      "endpoints": ["https://github.com/SKBv0/mynk/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "SKBv0",
    "copyright": "Copyright (c) 2026 SKBv0. MIT License.",
    "category": "Productivity",
    "shortDescription": "Bookmark manager with AI summaries",
    "externalBin": ["binaries/mynk-mcp"],
    "longDescription": "Bookmark manager that summarizes, categorizes and tags your saved pages with a local or cloud AI model.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
